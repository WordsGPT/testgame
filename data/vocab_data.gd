static func get_by_id(item_id: String) -> Dictionary:
	for item in ITEMS:
		if item["id"] == item_id:
			return item
	return {}


static func get_grammar_by_id(gram_id: String) -> Dictionary:
	for g in GRAMMAR_BREACHES:
		if g["id"] == gram_id:
			return g
	return {}


static func get_modifier_by_id(mod_id: String) -> Dictionary:
	for m in MODIFIER_DRILLS:
		if m["id"] == mod_id:
			return m
	return {}


static func get_scenario_by_id(scen_id: String) -> Dictionary:
	for s in SCENARIOS:
		if s["id"] == scen_id:
			return s
	return {}


static func get_all_ids() -> Array[String]:
	var out: Array[String] = []
	for item in ITEMS:
		out.append(item["id"])
	return out


static func get_all_grammar_ids() -> Array[String]:
	var out: Array[String] = []
	for g in GRAMMAR_BREACHES:
		out.append(g["id"])
	return out


static func get_sector_ids(sector_idx: int) -> Array[String]:
	var out: Array[String] = []
	for item in ITEMS:
		if item["sector"] == sector_idx:
			out.append(item["id"])
	return out


static func get_cefr_vocab_ids(cefr_prefix: String) -> Array[String]:
	var out: Array[String] = []
	for item in ITEMS:
		if String(item["cefr"]).begins_with(cefr_prefix):
			out.append(item["id"])
	return out
